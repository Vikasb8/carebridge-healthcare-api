  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzkxNzExNTc4LCJpYXQiOjE3OTE3MDc5NzgsImp0aSI6IjBhMmE2MTlkODI0NDQ1NzE4NWJiMzU3YjVhODM3NmJkIiwidXNlcl9pZCI6IjMifQ.qONwZDTTLEH3cGHIlM6RHyLb6pzdOMnT-8PcFjnDT2U"
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "patient_id",
      "value": "1"
